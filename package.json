{
  "name": "codeylon-website",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4173",
    "build": "next build && node scripts/finalize-export.mjs",
    "start": "next start -p 4173",
    "validate": "python3 scripts/validate_site.py",
    "check": "npm run build && npm run validate",
    "deploy": "npm run build && npx wrangler pages deploy out --project-name=codeylon-website"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
